# GEMINI_API_KEY: Required if Gemini API routes are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NASA FIRMS API Key (Obtain free at https://firms.modaps.eosdis.nasa.gov/api/)
FIRMS_MAP_KEY="MY_NASA_FIRMS_MAP_KEY"

# GitHub SQL Queue + Dataset Sync (Mistral 7B runs on Kaggle, not locally)
GITHUB_REPO="AriyaMon/NasaSpaceAppsFireLedger"
GITHUB_TOKEN=""
