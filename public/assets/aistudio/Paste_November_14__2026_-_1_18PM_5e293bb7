@app.get("/api/brief")
def brief():
    b = parse_bbox()
    if b is None:
        return jsonify(error="Invalid area of interest"), 400
    h, meta_ = analysis(b)
    ym = request.args.get("ym") or str(h.index[-1])
    try:
        row = h.loc[pd.Period(ym, "M")]
    except KeyError:
        return jsonify(error="Month not found"), 404
    if row["median"] != row["median"]:
        return jsonify(error="Not enough multi-year history in this box yet."), 422
    facts = build_facts(row, meta_)
    out = make_brief(facts, request.args.get("audience", "Responder"))
    return jsonify(facts=facts, **out)


