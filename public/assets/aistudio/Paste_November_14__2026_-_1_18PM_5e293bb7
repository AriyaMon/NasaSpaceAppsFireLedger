        if sensor_family == "modis":
            df = df[pd.to_numeric(conf, errors="coerce") >= 30]
        else:
            df = df[conf.isin(["n", "h", "nominal", "high"])]

    if df.empty:
        return pd.DataFrame()

    inst = df["instrument"].astype(str) if "instrument" in df.columns else sensor_family.upper()
    out = pd.DataFrame({
        "date": pd.to_datetime(df["acq_date"], errors="coerce"),
        "lat": pd.to_numeric(df["latitude"], errors="coerce").astype("float32"),
        "lon": pd.to_numeric(df["longitude"], errors="coerce").astype("float32"),
