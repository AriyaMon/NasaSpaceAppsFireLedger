"""MODIS -> VIIRS-equivalent monthly hotspot counts, with conformal prediction intervals."""
import numpy as np
import pandas as pd
import config as C

VIIRS_FROM = pd.Period(C.VIIRS_FULL_FROM, "M")
TWO_SAT_FROM = pd.Period(C.MODIS_TWO_SAT_FROM, "M")
ALPHA = 0.10


def counts_from_arrays(mon, is_viirs, m0, m1):
    """mon: month ordinals (year*12+month-1), is_viirs: bool array. Returns monthly counts per sensor."""
    n = m1 - m0 + 1
    mod = np.bincount(mon[~is_viirs] - m0, minlength=n)[:n]
    vii = np.bincount(mon[is_viirs] - m0, minlength=n)[:n].astype(float)
    idx = pd.period_range(pd.Period(year=m0 // 12, month=m0 % 12 + 1, freq="M"), periods=n, freq="M")
    df = pd.DataFrame({"modis": mod.astype(float), "viirs": vii}, index=idx)
    df.loc[df.index < VIIRS_FROM, "viirs"] = np.nan  # VIIRS not flying: missing, not zero
    return df


def _cq(res):
    k = min(1.0, np.ceil((len(res) + 1) * (1 - ALPHA)) / len(res))
    return float(np.quantile(res, k, method="higher"))


def _fit(x, y):
    b, a = np.polyfit(x, y, 1)
    return a, b


def fit_model(counts):
    """Fit log1p(VIIRS) ~ log1p(MODIS) on overlap months. Cross-fit by alternating years for honest errors."""
    ov = counts.dropna(subset=["viirs"])
    ov = ov[(ov.modis > 0) | (ov.viirs > 0)]
    if len(ov) < 24 or ov.viirs.sum() < 30:
        return None

    x, y = np.log1p(ov.modis.values), np.log1p(ov.viirs.values)
    even = ov.index.year % 2 == 0
    folds, preds = [], np.full(len(ov), np.nan)

    for tr, te in ((even, ~even), (~even, even)):
        if tr.sum() < 8 or te.sum() < 8:
            return None
        a, b = _fit(x[tr], y[tr])
        p = a + b * x[te]
        preds[te] = p
        folds.append(np.abs(y[te] - p))

    q0, q1 = _cq(folds[0]), _cq(folds[1])
    cover = (np.mean(folds[1] <= q0) + np.mean(folds[0] <= q1)) / 2  # genuinely out-of-fold

    a, b = _fit(x, y)
    obs, pr = np.expm1(y), np.expm1(preds)
    ss_res, ss_tot = np.sum((y - preds) ** 2), np.sum((y - y.mean()) ** 2)

    return dict(
        a=float(a),
        b=float(b),
        q=_cq(np.concatenate(folds)),
        n_overlap=int(len(ov)),
        mae=float(np.mean(np.abs(pr - obs))),
        bias_pct=float(100 * (pr.sum() - obs.sum()) / max(obs.sum(), 1)),
        r2_log=float(1 - ss_res / ss_tot),
        coverage=float(cover),
        nominal=1 - ALPHA,
    )


def harmonize(counts, fallback=None):
    """Returns (monthly dataframe, metrics). Observed VIIRS months stay observed; earlier months are translated."""
    model, used = fit_model(counts), "aoi"
    if model is None and fallback is not None:
        model, used = dict(fallback, q=fallback["q"] * 2), "regional"  # sparse AOI: borrow regional model, widen band

    out = counts.copy()
    out["value"], out["lo"], out["hi"], out["source"] = np.nan, np.nan, np.nan, ""

    for per, row in counts.iterrows():
        if not np.isnan(row.viirs):
            out.loc[per, ["value", "lo", "hi", "source"]] = [row.viirs, row.viirs, row.viirs, "viirs"]
        elif model is not None:
            p = model["a"] + model["b"] * np.log1p(row.modis)
            q = model["q"] * (1.5 if per < TWO_SAT_FROM else 1.0)  # Terra-only era is less certain
            out.loc[per, ["value", "lo", "hi", "source"]] = [
                np.expm1(max(p, 0)),
                np.expm1(max(p - q, 0)),
                np.expm1(p + q),
                "modis_terra" if per < TWO_SAT_FROM else "modis",
            ]

    meta = dict(model) if model else {}
    meta["model_source"] = used if model else "none"
    return out, meta


def annotate(h):
    """Add per-calendar-month median, ratio and percentile (with interval) against the same month in other years."""
    h = h.copy()
    h["year"], h["month"] = h.index.year, h.index.month
    h["median"], h["ratio"], h["pct"], h["pct_lo"], h["pct_hi"] = np.nan, np.nan, np.nan, np.nan, np.nan

    for m, g in h.groupby("month"):
        vals = np.sort(g["value"].dropna().values)
        if len(vals) < 5:
            continue
        med = float(np.median(vals))
        pc = lambda v: 100 * np.searchsorted(vals, v, side="right") / len(vals)
        for per, r in g.iterrows():
            if np.isnan(r.value):
                continue
            h.loc[per, ["median", "ratio", "pct", "pct_lo", "pct_hi"]] = [
                med,
                (r.value / med) if med > 0 else np.nan,
                pc(r.value),
                pc(r.lo),
                pc(r.hi),
            ]

    U = C.UNUSUAL_PCT
    h["conf"] = np.where(h.pct_lo >= U, "high", np.where(h.pct >= U, "medium", "low"))
    return h
