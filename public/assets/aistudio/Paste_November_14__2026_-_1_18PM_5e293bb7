        "sensor": "VIIRS" if r.viirs > 0 else "MODIS-harmonized",
    }
    for _, r in agg.iterrows()
]
return jsonify(cells=cells)
@app.post("/api/fetch_live")
def fetch_live():
body = request.get_json(silent=True) or {}
try:
b = {k: float(body[k]) for k in ("west", "south", "east", "north")}
except (KeyError, ValueError, TypeError):
return jsonify(error="Invalid bounding box coordinates"), 400

start_date = body.get("start_date", "2023-05-01")
end_date = body.get("end_date", "2023-08-31")

try:
    new_df, stats = fetch_area_range(b, start_date, end_date, map_key=C.MAP_KEY)
except Exception as e:
    return jsonify(error=str(e)), 502

if not new_df.empty:
    base_df = pd.DataFrame() if S["demo"] else S["df"]
    merged = pd.concat([base_df, new_df], ignore_index=True)
    merged = merged.drop_duplicates(subset=["date", "lat", "lon", "sensor"])
    merged["sensor"] = merged["sensor"].astype("category")
    C.PROC.mkdir(parents=True, exist_ok=True)
    merged.to_parquet(C.DETECTIONS)
    C.DEMO_FLAG.unlink(missing_ok=True)
    load()

return jsonify(
    ok=True,
    fetched_rows=len(new_df),
    total_cached=len(S["df"]),
    demo=S["demo"],
    stats=stats,
)
@app.get("/api/analyze")
def analyze():
b = parse_bbox()
if b is None:
return jsonify(error="Invalid area of interest"), 400
h, meta_ = analysis(b)
st, en = request.args.get("start"), request.args.get("end")
if st:
h = h[h.index >= pd.Period(st, "M")]
if en:
h = h[h.index <= pd.Period(en, "M")]

cols = [
