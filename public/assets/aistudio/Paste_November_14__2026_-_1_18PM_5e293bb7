"""Live NASA FIRMS Area API client supporting global bounding boxes and SP/NRT date splitting."""
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timedelta
from io import StringIO
import pandas as pd
import requests
import config as C


def get_data_availability(map_key=C.MAP_KEY):
    """Query NASA FIRMS for exact min/max dates available for MODIS and VIIRS (SP & NRT)."""
    url = f"{C.FIRMS_API_BASE}/data_availability/csv/{map_key}/ALL"
    r = requests.get(url, timeout=30)
    r.raise_for_status()
    if "data_id" not in r.text:
        raise RuntimeError(f"FIRMS API error: {r.text[:200]}")
    df = pd.read_csv(StringIO(r.text))
    return {
        row["data_id"]: (str(row["min_date"]), str(row["max_date"]))
        for _, row in df.iterrows()
    }


def _fetch_chunk(map_key, source, bbox_str, day_range, date_str):
    url = f"{C.FIRMS_API_BASE}/area/csv/{map_key}/{source}/{bbox_str}/{day_range}/{date_str}"
    r = requests.get(url, timeout=60)
    if r.status_code != 200:
        return pd.DataFrame()
    txt = r.text.strip()
    if not txt or "latitude" not in txt.splitlines()[0].lower():
        return pd.DataFrame()
    return pd.read_csv(StringIO(txt), low_memory=False)


def clean_firms_df(df, sensor):
    """Standardize column schemas across SP and NRT feeds and filter noise."""
    if df.empty:
        return pd.DataFrame(columns=["date", "lat", "lon", "sensor", "frp", "daynight"]), {"raw": 0, "kept": 0}

    df = df.copy()
    df.columns = [c.lower() for c in df.columns]
    acc = {"raw": len(df)}

    # Keep vegetation fires (type == 0) when SP 'type' column is present
    if "type" in df.columns:
        df = df[pd.to_numeric(df["type"], errors="coerce").fillna(0) == 0]
    acc["vegetation_type"] = len(df)

    # Sensor-specific confidence filtering
    conf = df["confidence"].astype(str).str.lower().str.strip()
    if sensor == "modis":
        keep = pd.to_numeric(conf, errors="coerce") >= 30
    else:
        keep = conf.isin(["n", "h", "nominal", "high"])
    df = df[keep]
    acc["kept"] = len(df)

    if df.empty:
        return pd.DataFrame(columns=["date", "lat", "lon", "sensor", "frp", "daynight"]), acc

    out = pd.DataFrame({
        "date": pd.to_datetime(df["acq_date"]),
        "lat": df["latitude"].astype("float32"),
        "lon": df["longitude"].astype("float32"),
        "sensor": sensor,
        "frp": pd.to_numeric(df["frp"], errors="coerce").astype("float32") if "frp" in df.columns else 0.0,
        "daynight": df["daynight"].astype(str) if "daynight" in df.columns else "D",
    })
    return out, acc


def fetch_area_range(bbox, start_date, end_date, map_key=C.MAP_KEY, max_workers=6):
    """
    Fetch both MODIS and VIIRS S-NPP hotspots for any global bounding box [west, south, east, north]
    between start_date and end_date (YYYY-MM-DD), automatically routing SP vs NRT feeds.
    """
    avail = get_data_availability(map_key)
    bbox_str = f"{bbox['west']:.4f},{bbox['south']:.4f},{bbox['east']:.4f},{bbox['north']:.4f}"

    s_dt = datetime.strptime(start_date[:10], "%Y-%m-%d").date()
    e_dt = datetime.strptime(end_date[:10], "%Y-%m-%d").date()

    tasks = []
    sensor_sources = {
        "modis": ["MODIS_SP", "MODIS_NRT"],
        "viirs": ["VIIRS_SNPP_SP", "VIIRS_SNPP_NRT"],
    }

    for sensor, sources in sensor_sources.items():
        for src in sources:
            if src not in avail:
                continue
            a_min = datetime.strptime(avail[src][0], "%Y-%m-%d").date()
            a_max = datetime.strptime(avail[src][1], "%Y-%m-%d").date()
            cur = max(s_dt, a_min)
            stop = min(e_dt, a_max)
            # Avoid duplicating dates covered by SP when querying NRT
            if src.endswith("_NRT") and src.replace("_NRT", "_SP") in avail:
                sp_max = datetime.strptime(avail[src.replace("_NRT", "_SP")][1], "%Y-%m-%d").date()
                cur = max(cur, sp_max + timedelta(days=1))

            while cur <= stop:
                days = min(5, (stop - cur).days + 1)  # FIRMS Area API allows 1..5 days per call
                tasks.append((sensor, src, days, cur.strftime("%Y-%m-%d")))
                cur += timedelta(days=days)

    raw_by_sensor = {"modis": [], "viirs": []}
    with ThreadPoolExecutor(max_workers=max_workers) as pool:
        futures = {
            pool.submit(_fetch_chunk, map_key, src, bbox_str, days, d_str): sensor
            for sensor, src, days, d_str in tasks
        }
        for fut in as_completed(futures):
            sensor = futures[fut]
            chunk = fut.result()
            if not chunk.empty:
                raw_by_sensor[sensor].append(chunk)

    cleaned_parts = []
    stats = {"api_calls": len(tasks)}
    for sensor in ("modis", "viirs"):
        if raw_by_sensor[sensor]:
            combined = pd.concat(raw_by_sensor[sensor], ignore_index=True)
            cleaned, acc = clean_firms_df(combined, sensor)
            cleaned_parts.append(cleaned)
            stats[sensor] = acc
        else:
            stats[sensor] = {"raw": 0, "kept": 0}

    result = pd.concat(cleaned_parts, ignore_index=True) if cleaned_parts else pd.DataFrame()
    return result, stats
