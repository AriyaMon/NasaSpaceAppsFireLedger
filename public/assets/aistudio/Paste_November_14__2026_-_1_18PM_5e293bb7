def run_gee_check(bbox, year, month):
"""Attempt live GEE Python API dNBR area check if Earth Engine is initialized on this machine."""
script = generate_gee_script(bbox, year, month)
try:
import ee
ee.Initialize()
last_day = calendar.monthrange(year, month)[1]
aoi = ee.Geometry.Rectangle([bbox["west"], bbox["south"], bbox["east"], bbox["north"]])
pre = (
ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
.filterBounds(aoi)
.filterDate(f"{year - 1}-{month:02d}-01", f"{year - 1}-{month:02d}-{last_day:02d}")
.filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 30))
.median()
.normalizedDifference(["B8", "B12"])
)
post = (
ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
.filterBounds(aoi)
.filterDate(f"{year}-{month:02d}-01", f"{year}-{month:02d}-{last_day:02d}")
