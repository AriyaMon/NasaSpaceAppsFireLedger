    async function runGeeValidation() {
      $("#geeBox").innerHTML = `<span class="mut">Running Google Earth Engine Sentinel-2 dNBR burn-scar validation for ${sel || "2023-06"}...</span>`;
      const p = q(); p.set("ym", sel || "2023-06");
