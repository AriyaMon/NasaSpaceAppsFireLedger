def run_gee_check(bbox, year, month):
    last_day = calendar.monthrange(year, month)[1]
    fire_start = f"{year}-{month:02d}-01"
    pre_start = f"{year - 1}-{month:02d}-01"
    pre_end = f"{year - 1}-{month:02d}-{last_day:02d}"
    post_year = year if month <= 10 else year + 1
    post_month = min(12, month + 1) if month <= 10 else 1
    post_end = f"{post_year}-{post_month:02d}-28"

    script = f"""// FireLedger Independent Burn-Scar Validation (Sentinel-2 SR dNBR)
// Paste into https://code.earthengine.google.com/
var aoi = ee.Geometry.Rectangle([{bbox['west']:.4f}, {bbox['south']:.4f}, {bbox['east']:.4f}, {bbox['north']:.4f}]);
Map.centerObject(aoi, 8);

function maskS2clouds(img) {{
  var scl = img.select('SCL');
  var mask = scl.neq(3).and(scl.neq(8)).and(scl.neq(9)).and(scl.neq(10));
  return img.updateMask(mask).divide(10000);
}}
function addNBR(img) {{ return img.normalizedDifference(['B8', 'B12']).rename('NBR'); }}

var preFire = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(aoi).filterDate('{pre_start}', '{pre_end}')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30))
  .map(maskS2clouds).map(addNBR).median();

var postFire = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(aoi).filterDate('{fire_start}', '{post_end}')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30))
  .map(maskS2clouds).map(addNBR).median();

var dNBR = preFire.subtract(postFire).rename('dNBR').clip(aoi);
var burnMask = dNBR.gt(0.27);
var stats = burnMask.multiply(ee.Image.pixelArea()).divide(1e6).reduceRegion({{
  reducer: ee.Reducer.sum(), geometry: aoi, scale: 100, maxPixels: 1e9
}});
print('Estimated Sentinel-2 Burned Area (sq km):', stats.get('dNBR'));
Map.addLayer(dNBR, {{min: -0.2, max: 0.8, palette: ['#1a9850', '#ffffbf', '#f46d43', '#67001f']}}, 'dNBR Severity');
Map.addLayer(burnMask.selfMask(), {{palette: ['#ff0055']}}, 'Burn Scar (dNBR > 0.27)');
"""
    try:
        import ee
        ee.Initialize()
        aoi = ee.Geometry.Rectangle([bbox["west"], bbox["south"], bbox["east"], bbox["north"]])
        pre = (
            ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
            .filterBounds(aoi).filterDate(pre_start, pre_end)
            .filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 30))
            .median().normalizedDifference(["B8", "B12"])
        )
        post = (
            ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
            .filterBounds(aoi).filterDate(fire_start, post_end)
            .filter(ee.Filter.lt("CLOUDY_PIXEL_PERCENTAGE", 30))
            .median().normalizedDifference(["B8", "B12"])
        )
        burned_km2 = (
            pre.subtract(post).gt(0.27).multiply(ee.Image.pixelArea()).divide(1e6)
            .reduceRegion(reducer=ee.Reducer.sum(), geometry=aoi, scale=250, maxPixels=1e8)
            .getInfo()
        )
        return {"mode": "live_ee", "burned_area_km2": round(float(list(burned_km2.values())[0] or 0), 2), "script": script}
    except Exception as exc:
        return {
            "mode": "script_ready",
            "note": f"Local GEE auth inactive ({type(exc).__name__}). Ready-to-run Google Earth Engine script generated below:",
            "script": script,
        }

