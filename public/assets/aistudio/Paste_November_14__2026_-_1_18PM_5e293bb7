const $ = s => document.querySelector(s);
const MN = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const VIRIDIS = ["#440154", "#482878", "#3e4989", "#31688e", "#26828e", "#1f9e89", "#35b779", "#6ece58", "#b5de2b", "#fde725"];

let meta, data, sel = null, audience = "Responder", map, drawn, viewer = null;

const ramp = t => VIRIDIS[Math.min(VIRIDIS.length - 1, Math.max(0, Math.floor(t * VIRIDIS.length)))];
const lum = h => {
const n = parseInt(h.slice(1), 16);
return ((n >> 16) * 0.299 + ((n >> 8) & 255) * 0.587 + (n & 255) * 0.114);
};
const fmt = v => v == null ? "–" : v >= 100 ? Math.round(v).toLocaleString() : v.toFixed(1);
const q = () => new URLSearchParams({
west: $("#west").value,
east: $("#east").value,
south: $("#south").value,
north: $("#north").value,
start: $("#start").value,
end: $("#end").value,
});

function initGlobe() {
try {
viewer = new Cesium.Viewer("globeContainer", {
imageryProvider: new Cesium.UrlTemplateImageryProvider({
url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
credit: "Esri World Imagery"
}),
baseLayerPicker: false,
geocoder: false,
homeButton: false,
sceneModePicker: false,
navigationHelpButton: false,
animation: false,
timeline: false,
fullscreenButton: false,
selectionIndicator: true,
infoBox: true
});
viewer.scene.globe.enableLighting = false;

const handler = new Cesium.ScreenSpaceEventHandler(viewer.scene.canvas);
handler.setInputAction(click => {
  const picked = viewer.scene.pick(click.position);
  if (Cesium.defined(picked) && picked.id && picked.id.properties) {
    const lat = picked.id.properties.lat.getValue();
    const lon = picked.id.properties.lon.getValue();
    setBox(lon - 3, lat - 3, lon + 3, lat + 3);
    run();
  }
}, Cesium.ScreenSpaceEventType.LEFT_CLICK);
} catch (e) {
console.warn("Cesium fallback:", e);
}
}

async function refreshGlobeCells() {
if (!viewer) return;
const r = await fetch("/api/globe_cells" + (sel ? ?ym=${sel} : ""));
const j = await r.json();
viewer.entities.removeAll();
const maxC = Math.max(...j.cells.map(c => c.count), 1);
j.cells.forEach(c => {
const norm = Math.log1p(c.count) / Math.log1p(maxC);
const height = 80000 + norm * 950000;
const color = norm > 0.7 ? Cesium.Color.ORANGERED.withAlpha(0.88)
: norm > 0.4 ? Cesium.Color.GOLD.withAlpha(0.85)
: Cesium.Color.CYAN.withAlpha(0.75);

viewer.entities.add({
  name: `Grid (${c.lat.toFixed(1)}°, ${c.lon.toFixed(1)}°)`,
  position: Cesium.Cartesian3.fromDegrees(c.lon, c.lat, height / 2),
  cylinder: {
    length: height,
    topRadius: 75000,
    bottomRadius: 75000,
    material: color
  },
  properties: { lat: c.lat, lon: c.lon },
  description: `Harmonized Hotspots: <b>${c.count}</b><br>MODIS: ${c.modis} | VIIRS: ${c.viirs}<br>Click bar to inspect 4°×4° region.`
});
});
}

function setBox(w, s, e, n) {
$("#west").value = Number(w).toFixed(2);
$("#south").value = Number(s).toFixed(2);
$("#east").value = Number(e).toFixed(2);
$("#north").value = Number(n).toFixed(2);

if (drawn) {
drawn.clearLayers();
if (w > -179 || e < 179) {
const rect = L.rectangle([[s, w], [n, e]], { color: "#ea580c", weight: 2 });
drawn.addLayer(rect);
map.fitBounds([[s, w], [n, e]], { padding: [20, 20] });
} else {
map.setView([15, 0], 1);
}
}
if (viewer && (w > -179 || e < 179)) {
viewer.camera.flyTo({
destination: Cesium.Rectangle.fromDegrees(
Math.max(-180, w - 5),
Math.max(-85, s - 5),
Math.min(180, e + 5),
Math.min(85, n + 5)
),
duration: 1.0
});
} else if (viewer) {
viewer.camera.flyHome(1.0);
}
}

async function init() {
meta = await (await fetch("/api/meta")).json();
$("#demo").hidden = !meta.demo;
$("#start").value = meta.first;
$("#end").value = meta.last;
$("#ramp").style.background = linear-gradient(90deg,${VIRIDIS.join(",")});

initGlobe();

map = L.map("map").setView([15, 0], 1);
L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", {
attribution: "Esri Satellite"
}).addTo(map);
drawn = new L.FeatureGroup().addTo(map);

map.addControl(new L.Control.Draw({
edit: false,
draw: { rectangle: true, polygon: false, polyline: false, circle: false, marker: false, circlemarker: false },
}));

map.on(L.Draw.Event.CREATED, e => {
const b = e.layer.getBounds();
setBox(b.getWest(), b.getSouth(), b.getEast(), b.getNorth());
run();
});

$("#btnGlobe").onclick = () => {
$("#btnGlobe").classList.add("on");
$("#btnMap").classList.remove("on");
$("#globeContainer").hidden = false;
$("#map").hidden = true;
$("#mapHint").textContent = "Orbit 3D Earth or click any extruded bar to zoom & inspect that grid cell.";
};

$("#btnMap").onclick = () => {
