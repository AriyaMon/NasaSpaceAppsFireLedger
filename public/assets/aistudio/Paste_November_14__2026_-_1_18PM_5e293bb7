"""Facts -> briefing text. The LLM (Kaggle) only rewrites facts; a verifier rejects any number not in the facts."""
import os
import re
import requests

MONTHS = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
]


def build_facts(row, aoi, metrics):
    r = lambda v: None if v is None or v != v else int(round(v))
    return dict(
        year=int(row["year"]),
        month=MONTHS[int(row["month"]) - 1],
        count=r(row["value"]),
        lo=r(row["lo"]),
        hi=r(row["hi"]),
        median=r(row["median"]),
        pct_of_median=r(100 * row["ratio"]) if row["ratio"] == row["ratio"] else None,
        percentile=r(row["pct"]),
        pct_lo=r(row["pct_lo"]),
        pct_hi=r(row["pct_hi"]),
        confidence=row["conf"],
        source=row["source"],
        coverage_pct=r(100 * metrics.get("coverage", 0)) if metrics.get("coverage") else None,
        caveats=[
            "cloud cover hides fires",
            "MODIS-era months are model-translated" if row["source"] != "viirs" else "VIIRS observed",
        ],
    )


def template(f, audience):
    st = {
        "high": "unusually high",
        "medium": "possibly unusual",
        "low": "within the normal range or inconclusive",
    }[f["confidence"]]
    rng = (
        "observed by VIIRS"
        if f["lo"] == f["hi"]
        else f'VIIRS-equivalent, plausible range {f["lo"]} to {f["hi"]}'
    )
    base = (
        f'{f["month"]} {f["year"]}: about {f["count"]} hotspots ({rng}), '
        f'{f["pct_of_median"]}% of the usual {f["month"]} median of {f["median"]}. '
        f'Activity is {st} (percentile {f["percentile"]}).'
    )
    tail = {
        "Responder": (
            " Do not escalate on this signal alone."
            if f["confidence"] == "low"
            else " Prioritise this area in the next monitoring cycle."
        ),
        "Scientist": (
            f' Interval from conformal calibration; measured out-of-fold coverage {f["coverage_pct"]}%.'
            if f["coverage_pct"]
            else ""
        ),
        "Land manager": " Use this when timing fuel checks and burn-permit decisions.",
    }.get(audience, "")
    return base + tail


def verify(text, facts):
    allowed = {v for v in facts.values() if isinstance(v, int)} | {90}
    nums = [int(n) for n in re.findall(r"\d+", text)]
    return all(n in allowed for n in nums), len(nums)


def call_llm(facts, audience):
    url = os.environ.get("LLM_URL")  # e.g. your ngrok URL to the Kaggle notebook
    if not url:
        return None
    try:
        r = requests.post(url, json={"facts": facts, "audience": audience}, timeout=15)
        return r.json().get("text")
    except Exception:
        return None


def make_brief(facts, audience):
    for _ in range(2):
        text = call_llm(facts, audience)
        if text:
            ok, n = verify(text, facts)
            if ok:
                return dict(text=text, source="model", figures=n)
    text = template(facts, audience)
    return dict(text=text, source="template", figures=verify(text, facts)[1])
