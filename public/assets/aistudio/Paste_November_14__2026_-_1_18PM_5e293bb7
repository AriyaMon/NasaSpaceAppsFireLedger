# 5. HARMONIZE MODIS -> VIIRS EQUIVALENT & SAVE COMPACT GRID SUMMARY
# =============================================================================
def build_harmonized_summary(grid_accum, total_rows):
    print("[4/5] Computing global MODIS -> VIIRS harmonization model...")
    grid = pd.concat(grid_accum, ignore_index=True).groupby(["ym", "lat_bin", "lon_bin"], as_index=False).sum()
    monthly = grid.groupby("ym", as_index=False)[["modis", "viirs"]].sum().sort_values("ym")

    ov = monthly[monthly["ym"] >= "2012-03"].copy()
    x = np.log1p(ov["modis"].to_numpy(dtype=float))
    y = np.log1p(ov["viirs"].to_numpy(dtype=float))
    b, a = np.polyfit(x, y, 1)
    res = np.abs(y - (a + b * x))
    q90 = float(np.quantile(res, 0.90))

    grid["harmonized_viirs_eq"] = np.where(
        grid["ym"] >= "2012-03",
        grid["viirs"].astype("float32"),
        np.expm1(np.maximum(a + b * np.log1p(grid["modis"]), 0)).astype("float32"),
    )
    grid.to_parquet(MONTHLY_GRID_PARQUET, compression="zstd", index=False)

    meta = {
        "updated_utc": datetime.now(timezone.utc).isoformat(),
        "total_detections": int(total_rows),
        "first_ym": str(monthly["ym"].min()),
        "last_ym": str(monthly["ym"].max()),
        "global_harmonization": {"a": float(a), "b": float(b), "q90": q90},
    }
    META_JSON.write_text(json.dumps(meta, indent=2), encoding="utf-8")
    print(f"  Global calibration: log1p(VIIRS) = {a:.4f} + {b:.4f} * log1p(MODIS) (q90={q90:.4f})")
    return meta


