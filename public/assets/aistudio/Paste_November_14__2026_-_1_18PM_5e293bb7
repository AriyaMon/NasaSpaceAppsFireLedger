"lat": lat.astype("float32"),
"lon": lon.astype("float32"),
"sensor": sensor,
"frp": rng.gamma(2, 9, n).astype("float32"),
"daynight": rng.choice(["D", "N"], n),
}))

df = pd.concat(rows, ignore_index=True)
df["sensor"] = df["sensor"].astype("category")
C.PROC.mkdir(parents=True, exist_ok=True)
df.to_parquet(C.DETECTIONS)
C.DEMO_FLAG.write_text("synthetic")
