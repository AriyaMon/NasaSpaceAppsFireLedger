    function drawCal() {
      const S = data.series, years = [...new Set(S.map(s => s.year))], by = Object.fromEntries(S.map(s => [s.ym, s]));
      const mx = Math.log1p(Math.max(...S.map(s => s.value || 0), 1));
      $("#lmax").textContent = fmt(Math.expm1(mx)); $("#lmin").textContent = "0";
      let h = "<table><tr><th></th>" + MN.map(m => `<th>${m}</th>`).join("") + "</tr>";
      for (const y of years) {
        h += `<tr><th>${y}</th>`;
        for (let m = 1; m <= 12; m++) {
          const s = by[`${y}-${String(m).padStart(2, "0")}`];
          if (!s || s.value == null) { h += `<td class="n"></td>`; continue; }
          const c = ramp(Math.log1p(s.value) / mx), flag = s.conf === "high" ? "▲" : "";
          h += `<td data-ym="${s.ym}" class="${s.source !== "viirs" ? "h" : ""} ${s.ym === sel ? "sel" : ""}" style="background:${c};color:${lum(c) > 140 ? "#000" : "#fff"}" title="${s.ym}: ${fmt(s.value)} (${fmt(s.lo)}–${fmt(s.hi)})">${flag}</td>`;
        }
        h += "</tr>";
      }
      $("#cal").innerHTML = h + "</table>";
      document.querySelectorAll("#cal td[data-ym]").forEach(td => {
