files["pipeline/harmonize.py"] = """\"\"\"
Dual-Satellite Harmonization (2012-03 – Present):
Both MODIS (1 km) and VIIRS (375 m) are online across the entire timeline.
Computes:

Observed VIIRS monthly series

Sensor-harmonized MODIS -> VIIRS-equivalent series (log1p(VIIRS) ~ log1p(MODIS))

Dual-sensor consensus series & out-of-fold conformal 90% intervals

Cross-sensor residual diagnostics to detect sensor drift, cloud/smoke occlusion, or anomalies
"""
import numpy as np
import pandas as pd
import config as C

START_PERIOD = pd.Period(C.TIMELINE_START_YM, "M")
ALPHA = 0.10

def counts_from_arrays(mon, is_viirs, m0, m1):
m0 = max(m0, START_PERIOD.year * 12 + START_PERIOD.month - 1)
if m1 < m0:
m1 = m0
n = m1 - m0 + 1
valid = mon >= m0
mon_v = mon[valid] - m0
is_v = is_viirs[valid]

mod = np.bincount(mon_v[~is_v], minlength=n)[:n]
vii = np.bincount(mon_v[is_v], minlength=n)[:n]
idx = pd.period_range(pd.Period(year=m0 // 12, month=m0 % 12 + 1, freq="M"), periods=n, freq="M")
return pd.DataFrame({"modis": mod.astype(float), "viirs": vii.astype(float)}, index=idx)
def _cq(res):
k = min(1.0, np.ceil((len(res) + 1) * (1 - ALPHA)) / len(res))
return float(np.quantile(res, k, method="higher"))

def _fit(x, y):
b, a = np.polyfit(x, y, 1)
return a, b

def fit_model(counts):
"""Calibrate log1p(VIIRS) ~ log1p(MODIS) across the dual-satellite timeline via alternating-year CV."""
ov = counts[(counts.modis > 0) | (counts.viirs > 0)]
if len(ov) < 18 or ov.viirs.sum() < 25:
return None

x, y = np.log1p(ov.modis.values), np.log1p(ov.viirs.values)
even = ov.index.year % 2 == 0
folds, preds = [], np.full(len(ov), np.nan)

for tr, te in ((even, ~even), (~even, even)):
    if tr.sum() < 6 or te.sum() < 6:
        return None
    a, b = _fit(x[tr], y[tr])
    p = a + b * x[te]
    preds[te] = p
    folds.append(np.abs(y[te] - p))

q0, q1 = _cq(folds[0]), _cq(folds[1])
cover = (np.mean(folds[1] <= q0) + np.mean(folds[0] <= q1)) / 2

a, b = _fit(x, y)
obs, pr = np.expm1(y), np.expm1(preds)
ss_res, ss_tot = np.sum((y - preds) ** 2), np.sum((y - y.mean()) ** 2)

return dict(
    a=float(a),
    b=float(b),
    q=_cq(np.concatenate(folds)),
    n_overlap=int(len(ov)),
    mae=float(np.mean(np.abs(pr - obs))),
    bias_pct=float(100 * (pr.sum() - obs.sum()) / max(obs.sum(), 1)),
    r2_log=float(1 - ss_res / max(ss_tot, 1e-9)),
    coverage=float(cover),
    nominal=1 - ALPHA,
)
def harmonize(counts, fallback=None):
"""
Produce harmonized dual-satellite series (2012-03 – Present):
- value: Observed VIIRS count (primary 375m reference)
- modis_eq: MODIS count translated into VIIRS-equivalent units
- lo, hi: 90% conformal interval around MODIS-predicted VIIRS-equivalent
- naive: Raw unharmonized MODIS count (shows sensor-resolution gap)
