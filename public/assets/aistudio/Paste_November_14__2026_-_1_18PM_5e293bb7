app = Flask(__name__)
S = {}


def load_cache():
    ensure_starter_data()
    df = pd.read_csv(CACHE_CSV, compression="gzip")
    df["dt"] = pd.to_datetime(df["date"])
    df = df.sort_values("dt").reset_index(drop=True)
    S.update(
        df=df,
        lat=df["lat"].to_numpy(dtype="float32"),
        lon=df["lon"].to_numpy(dtype="float32"),
        sen=(df["sensor"] == "viirs").to_numpy(),
        mon=(df["dt"].dt.year * 12 + df["dt"].dt.month - 1).to_numpy(dtype="int32"),
        demo=DEMO_FLAG.exists(),
    )
    S["m0"], S["m1"] = int(S["mon"].min()), int(S["mon"].max())
    S["global_model"] = harmonize(counts(None))[1]


def mask(b):
    return (
        (S["lat"] >= b["south"])
        & (S["lat"] <= b["north"])
        & (S["lon"] >= b["west"])
        & (S["lon"] <= b["east"])
    )


def counts(b):
    m = np.ones(len(S["lat"]), bool) if b is None else mask(b)
    return counts_from_arrays(S["mon"][m], S["sen"][m], S["m0"], S["m1"])


def parse_bbox():
    try:
        b = {k: float(request.args.get(k, WORLD[k])) for k in ("west", "south", "east", "north")}
    except ValueError:
        return None
    b = dict(
        west=max(b["west"], WORLD["west"]),
        east=min(b["east"], WORLD["east"]),
        south=max(b["south"], WORLD["south"]),
        north=min(b["north"], WORLD["north"]),
    )
    return b if b["west"] < b["east"] and b["south"] < b["north"] else None


def js(v):
    return None if v is None or (isinstance(v, float) and v != v) else (float(v) if isinstance(v, (np.floating,)) else v)


def analysis(b):
    h, meta = harmonize(counts(b), fallback=S["global_model"])
    return annotate(h), meta


@app.get("/")
def index():
    return render_template_string(HTML_PAGE)


@app.get("/api/meta")
def meta():
    p = lambda o: pd.Period(year=o // 12, month=o % 12 + 1, freq="M").strftime("%Y-%m")
    return jsonify(world=WORLD, first=p(S["m0"]), last=p(S["m1"]), demo=S["demo"], unusual_pct=UNUSUAL_PCT)


@app.get("/api/globe_cells")
def globe_cells():
    ym = request.args.get("ym")
    df = S["df"]
    if ym:
        p = pd.Period(ym, "M")
        df = df[(df["dt"] >= p.start_time) & (df["dt"] <= p.end_time)]
    if df.empty:
        return jsonify(cells=[])

    g_lat = np.floor(df["lat"].to_numpy() / 2.0) * 2.0 + 1.0
    g_lon = np.floor(df["lon"].to_numpy() / 2.0) * 2.0 + 1.0
    is_v = (df["sensor"] == "viirs").to_numpy()
    temp = pd.DataFrame({"lat": g_lat, "lon": g_lon, "viirs": is_v.astype(int), "modis": (~is_v).astype(int)})
    agg = temp.groupby(["lat", "lon"], as_index=False).sum()

    gm = S["global_model"]
    a, b_coef = gm.get("a", 0.5), gm.get("b", 1.05)
    agg["harmonized"] = np.where(
        agg["viirs"] > 0,
        agg["viirs"].astype(float),
        np.expm1(np.maximum(a + b_coef * np.log1p(agg["modis"]), 0)),
    )
    agg = agg.sort_values("harmonized", ascending=False).head(450)
    return jsonify(cells=[
        {
            "lat": float(r.lat), "lon": float(r.lon),
            "count": round(float(r.harmonized), 1),
            "modis": int(r.modis), "viirs": int(r.viirs),
        }
        for _, r in agg.iterrows()
    ])


@app.post("/api/fetch_live")
def fetch_live():
    body = request.get_json(silent=True) or {}
    try:
        b = {k: float(body[k]) for k in ("west", "south", "east", "north")}
    except (KeyError, ValueError, TypeError):
        return jsonify(error="Invalid bounding box coordinates"), 400

    start_date = body.get("start_date", "2023-06-01")
    end_date = body.get("end_date", "2023-07-31")

    try:
        new_df, stats = fetch_area_range(b, start_date, end_date, map_key=MAP_KEY)
    except Exception as e:
        return jsonify(error=str(e)), 502

    if not new_df.empty:
        cols = ["date", "lat", "lon", "sensor", "frp", "daynight"]
        base_df = pd.DataFrame(columns=cols) if S["demo"] else S["df"][cols]
        merged = pd.concat([base_df, new_df[cols]], ignore_index=True)
        merged = merged.drop_duplicates(subset=["date", "lat", "lon", "sensor"])
        merged.to_csv(CACHE_CSV, index=False, compression="gzip")
        DEMO_FLAG.unlink(missing_ok=True)
        load_cache()

    return jsonify(ok=True, fetched_rows=len(new_df), total_cached=len(S["df"]), demo=S["demo"], stats=stats)


@app.get("/api/analyze")
def analyze():
    b = parse_bbox()
    if b is None:
        return jsonify(error="Invalid area of interest"), 400
    h, meta_ = analysis(b)
    st, en = request.args.get("start"), request.args.get("end")
    if st:
        h = h[h.index >= pd.Period(st, "M")]
    if en:
        h = h[h.index <= pd.Period(en, "M")]

    cols = [
        "year", "month", "value", "naive", "lo", "hi", "source",
        "modis", "viirs", "median", "ratio", "pct", "pct_lo", "pct_hi", "conf",
    ]
    series = [{"ym": str(i), **{c: js(r[c]) for c in cols}} for i, r in h.iterrows()]
    m = mask(b)

    return jsonify(
        aoi=b,
        unit="VIIRS-equivalent hotspots per month",
        series=series,
        metrics={k: js(v) for k, v in meta_.items()},
        n_detections=dict(modis=int((~S["sen"][m]).sum()), viirs=int(S["sen"][m].sum())),
        caveats=[
            "Hotspots are presence-only: cloud cover and thick smoke hide fires.",
            "Pre-2012 months are MODIS translated into VIIRS-equivalent units (dashed border).",
            "Before 2002-07 only Terra flew, so early MODIS intervals are widened 1.5x.",
            "Low-confidence pixels and non-vegetation thermal sources (flares, volcanoes) are filtered out.",
        ],
    )


