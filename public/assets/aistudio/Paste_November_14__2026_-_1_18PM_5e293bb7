const c = ramp(Math.log1p(s.value) / mx);
const flag = s.conf === "high" ? "▲" : "";
h += <td data-ym="${s.ym}" class="${s.ym === sel ? "sel" : ""}" style="background:${c};color:${lum(c) > 140 ? "#000" : "#fff"}" title="${s.ym}: VIIRS ${fmt(s.value)} | Calibrated MODIS ${fmt(s.modis_eq)}">${flag}</td>;
