"""Download bulk yearly country CSV archives from NASA FIRMS (no API key required for 2000-2025)."""
import pandas as pd
import requests
import config as C
from pipeline.firms_api import clean_firms_df


def archive_url(slug, year, country):
    return f"{C.FIRMS_COUNTRY_BASE}/{slug}/{year}/{slug}_{year}_{country}.csv"


def download_country_year(slug, year, country):
    C.RAW.mkdir(parents=True, exist_ok=True)
    path = C.RAW / f"{slug}_{year}_{country}.csv"
    if path.exists():
        return path
    url = archive_url(slug, year, country)
    r = requests.get(url, stream=True, timeout=300)
    if r.status_code == 404:
        print(f"  {slug} {year} ({country}): not published (404)")
        return None
    r.raise_for_status()
    tmp = path.with_suffix(".part")
    with open(tmp, "wb") as f:
        for chunk in r.iter_content(1 << 20):
            f.write(chunk)
    if "latitude" not in tmp.read_text(errors="ignore")[:400].lower():
        tmp.unlink()
        raise RuntimeError(f"{url} did not return a valid hotspot CSV")
    tmp.rename(path)
    return path


def clean_csv_file(path, sensor):
    df = pd.read_csv(path, low_memory=False)
    return clean_firms_df(df, sensor)
