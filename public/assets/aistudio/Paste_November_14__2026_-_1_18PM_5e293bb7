        if "frp" in df.columns else np.float32(0.0),
        "daynight": df["daynight"].astype(str) if "daynight" in df.columns else "D",
    }).dropna(subset=["date", "lat", "lon"])

    # Enforce dual-satellite timeline start (March 2012 onwards)
    out = out[out["date"] >= pd.Timestamp(f"{TIMELINE_START_YM}-01")]
