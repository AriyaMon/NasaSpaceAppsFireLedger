def push_to_github():
    print(f"[5/5] Uploading formatted dataset to GitHub ({GITHUB_REPO})...")
    repo_dir = WORK_DIR / "repo"
    auth_url = f"https://x-access-token:{GITHUB_TOKEN}@github.com/{GITHUB_REPO}.git"

    subprocess.run(["git", "clone", auth_url, str(repo_dir)], check=True)
    subprocess.run(["git", "-C", str(repo_dir), "config", "user.email", "kaggle-bot@fireledger.local"], check=True)
    subprocess.run(["git", "-C", str(repo_dir), "config", "user.name", "FireLedger Kaggle Builder"], check=True)

    target_proc = repo_dir / "data" / "processed"
    target_proc.mkdir(parents=True, exist_ok=True)
    (target_proc / "harmonized_global_monthly.parquet").write_bytes(MONTHLY_GRID_PARQUET.read_bytes())
    (target_proc / "dataset_meta.json").write_bytes(META_JSON.read_bytes())

    subprocess.run(["git", "-C", str(repo_dir), "add", "data/processed"], check=True)
    subprocess.run(["git", "-C", str(repo_dir), "commit", "-m", "Update worldwide harmonized MODIS+VIIRS data"], check=False)
    subprocess.run(["git", "-C", str(repo_dir), "push"], check=True)

    # Create or update GitHub Release 'data-latest' for the full detections.parquet (>100MB)
    headers = {
        "Authorization": f"Bearer {GITHUB_TOKEN}",
        "Accept": "application/vnd.github+json",
    }
    rel_api = f"https://api.github.com/repos/{GITHUB_REPO}/releases"
    r = requests.get(f"{rel_api}/tags/data-latest", headers=headers, timeout=30)
    if r.status_code == 200:
        rel = r.json()
        # Delete old detections.parquet asset if present
        for asset in rel.get("assets", []):
            if asset["name"] == "detections.parquet":
                requests.delete(f"{rel_api}/assets/{asset['id']}", headers=headers, timeout=30)
    else:
        r = requests.post(
            rel_api,
            headers=headers,
            json={"tag_name": "data-latest", "name": "Worldwide NASA FIRMS Dataset (Latest)", "prerelease": False},
            timeout=30,
        )
        r.raise_for_status()
        rel = r.json()

    upload_url = rel["upload_url"].split("{")[0] + "?name=detections.parquet"
    size_mb = DETECTIONS_PARQUET.stat().st_size / (1024 * 1024)
    print(f"  Uploading detections.parquet ({size_mb:.1f} MB) to GitHub Release 'data-latest'...")
    with open(DETECTIONS_PARQUET, "rb") as f:
        up = requests.post(
            upload_url,
            headers={**headers, "Content-Type": "application/octet-stream"},
            data=f,
            timeout=600,
        )
        up.raise_for_status()

    print("✓ Complete! GitHub repo and Release are updated and ready for VS Code.")


if __name__ == "__main__":
    countries = discover_all_countries()
    with pq.ParquetWriter(DETECTIONS_PARQUET, PARQUET_SCHEMA, compression="zstd") as writer:
        n_arch, grid_accum = stream_worldwide_archives(countries, writer)
        n_2026 = fetch_2026_live_global(writer, grid_accum)
    build_harmonized_summary(grid_accum, n_arch + n_2026)
    push_to_github()
