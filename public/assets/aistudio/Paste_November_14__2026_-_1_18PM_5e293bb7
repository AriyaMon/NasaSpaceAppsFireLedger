import numpy as np
import pandas as pd
import config as C

rng = np.random.default_rng(1)
R = C.REGION
centers = [(48.5, -74.5), (50.5, -70.0), (52.5, -67.0), (47.0, -77.0), (55.0, -72.0)]
rows = []

for y in range(2000, 2026):
    for m in range(1, 13):
        season = np.exp(-(((m - 6.5) / 1.6) ** 2)) + 0.03
        lam = 60 * season * (0.5 + rng.random() * 1.2) * (6 if y == 2023 else 1)
        for sensor, mult, start in (("modis", 1.0, (2000, 11)), ("viirs", 2.4, (2012, 3))):
            if (y, m) < start:
                continue
            n = rng.poisson(lam * mult * (0.85 + 0.3 * rng.random()))
            c = np.array(centers)[rng.integers(0, len(centers), n)]
            lat = np.clip(c[:, 0] + rng.normal(0, 1.2, n), R["south"], R["north"])
            lon = np.clip(c[:, 1] + rng.normal(0, 1.8, n), R["west"], R["east"])
            day = rng.integers(1, 28, n)
            rows.append(pd.DataFrame({
                "date": pd.to_datetime(dict(year=y, month=m, day=day)),
                "lat": lat.astype("float32"),
                "lon": lon.astype("float32"),
                "sensor": sensor,
                "frp": rng.gamma(2, 8, n).astype("float32"),
                "daynight": rng.choice(["D", "N"], n),
            }))

df = pd.concat(rows, ignore_index=True)
df["sensor"] = df["sensor"].astype("category")
