else " High-priority anomaly — cross-check with Landsat 30m verification and allocate monitoring resources."
),
"Scientist": (
f' Conformal interval calibrated on overlap years; held-out coverage {f["coverage_pct"]}%.'
if f["coverage_pct"]
else ""
),
"Land manager": " Factor this seasonal anomaly into prescribed-burn permits and fuel-load inspections.",
}.get(audience, "")
return base + tail

def verify(text, facts):
allowed = {v for v in facts.values() if isinstance(v, int)} | {90, 30}
nums = [int(n) for n in re.findall(r"\d+", text)]
return all(n in allowed for n in nums), len(nums)

