.median()
.normalizedDifference(["B8", "B12"])
)
dnbr = pre.subtract(post)
burned_km2 = (
dnbr.gt(0.27)
.multiply(ee.Image.pixelArea())
.divide(1e6)
.reduceRegion(reducer=ee.Reducer.sum(), geometry=aoi, scale=250, maxPixels=1e8)
.getInfo()
)
return {
"mode": "live_ee",
"burned_area_km2": round(float(list(burned_km2.values())[0] or 0), 2),
"script": script,
}
except Exception as exc:
return {
"mode": "script_ready",
"note": f"Local GEE Python auth not active ({type(exc).name}). Copy the generated script into Google Earth Engine Code Editor.",
"script": script,
}
