"""Grounded briefing generator with strict numeric verification against computed facts."""
import os
import re
import requests

MONTHS = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
]


def build_facts(row, aoi, metrics):
    r = lambda v: None if v is None or v != v else int(round(v))
    return dict(
        year=int(row["year"]),
        month=MONTHS[int(row["month"]) - 1],
        count=r(row["value"]),
        lo=r(row["lo"]),
        hi=r(row["hi"]),
        median=r(row["median"]),
        pct_of_median=r(100 * row["ratio"]) if row["ratio"] == row["ratio"] else None,
        percentile=r(row["pct"]),
        pct_lo=r(row["pct_lo"]),
        pct_hi=r(row["pct_hi"]),
        confidence=row["conf"],
        source=row["source"],
        coverage_pct=r(100 * metrics.get("coverage", 0)) if metrics.get("coverage") else None,
        caveats=[
            "Cloud cover and dense smoke can obscure active thermal anomalies.",
            "Pre-2012 MODIS counts are translated into VIIRS-equivalent units."
            if row["source"] != "viirs"
            else "Directly observed by VIIRS 375m sensor.",
        ],
    )


def template(f, audience):
    st = {
        "high": "unusually high",
        "medium": "elevated / possibly unusual",
        "low": "within normal historical range",
    }[f["confidence"]]
    rng = (
        "directly observed by VIIRS"
        if f["lo"] == f["hi"]
        else f'VIIRS-equivalent estimate, 90% interval {f["lo"]} to {f["hi"]}'
    )
    med_part = (
        f'{f["pct_of_median"]}% of the historical {f["month"]} median ({f["median"]})'
        if f["pct_of_median"] is not None
        else f'historical {f["month"]} median {f["median"]}'
    )
    base = (
        f'{f["month"]} {f["year"]}: {f["count"]} hotspots ({rng}), '
        f'{med_part}. Burning activity is {st} (percentile {f["percentile"]}).'
    )
    tail = {
        "Responder": (
            " Normal baseline — do not escalate on this signal alone."
            if f["confidence"] == "low"
            else " High-priority anomaly — allocate aerial/ground monitoring resources."
        ),
        "Scientist": (
            f' Conformal interval calibrated on overlap years; held-out coverage {f["coverage_pct"]}%.'
            if f["coverage_pct"]
            else ""
        ),
        "Land manager": " Factor this seasonal anomaly into prescribed-burn permits and fuel-load inspections.",
    }.get(audience, "")
    return base + tail


def verify(text, facts):
    allowed = {v for v in facts.values() if isinstance(v, int)} | {90}
    nums = [int(n) for n in re.findall(r"\d+", text)]
    return all(n in allowed for n in nums), len(nums)


def call_llm(facts, audience):
    url = os.environ.get("LLM_URL")
    if not url:
        return None
    try:
        r = requests.post(url, json={"facts": facts, "audience": audience}, timeout=15)
        return r.json().get("text")
    except Exception:
        return None


def make_brief(facts, audience):
    for _ in range(2):
        text = call_llm(facts, audience)
        if text:
            ok, n = verify(text, facts)
            if ok:
                return dict(text=text, source="model", figures=n)
    text = template(facts, audience)
    return dict(text=text, source="template", figures=verify(text, facts)[1])
