};
});

$("#run").onclick = run;
$("#showNaive").onchange = drawChart;
$("#fetchLive").onclick = fetchLive;
$("#btnGee").onclick = runGeeValidation;

document.querySelectorAll("#aud button").forEach(b => {
b.onclick = () => {
document.querySelectorAll("#aud button").forEach(x => x.classList.remove("on"));
b.classList.add("on");
audience = b.textContent;
