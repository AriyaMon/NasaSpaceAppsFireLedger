$("#chart").innerHTML = <svg viewBox="0 0 ${W} ${H}" width="100%"> ${band ?: ""} ${showNaive ?: ""} ${modisEqLine ?: ""} <polyline points="${viirsLine}" fill="none" stroke="#ea580c" stroke-width="1.9"/> <text x="2" y="12">${fmt(mx)}</text> <text x="${p}" y="${H - 4}">${S[0].ym}</text> <text x="${W - 44}" y="${H - 4}">${S[S.length - 1].ym}</text> </svg> <div class="mut">Orange = Observed VIIRS 375m · Teal = MODIS harmonized to VIIRS-equivalent (shaded = 90% conformal band) · Dashed grey = raw MODIS 1km.</div>;
