    function drawChart() {
      const S = data.series.filter(s => s.value != null);
      if (S.length < 2) return;
      const W = 700, H = 180, p = 34, showNaive = $("#showNaive").checked;
      const mx = Math.max(...S.map(s => Math.max(s.hi || 0, showNaive ? (s.naive || 0) : 0)), 1);
      const X = i => p + (i / (S.length - 1)) * (W - p - 8);
      const Y = v => H - 20 - (v / mx) * (H - 34);
      const band = S.map((s, i) => `${X(i)},${Y(s.hi)}`).join(" ") + " " + S.map((s, i) => `${X(S.length - 1 - i)},${Y(S[S.length - 1 - i].lo)}`).join(" ");
      const line = S.map((s, i) => `${X(i)},${Y(s.value)}`).join(" ");
      const naiveLine = S.map((s, i) => `${X(i)},${Y(s.naive || 0)}`).join(" ");
      const vi = S.findIndex(s => s.source === "viirs");
      $("#chart").innerHTML = `
        <svg viewBox="0 0 ${W} ${H}" width="100%">
          <polygon points="${band}" fill="#ea580c" opacity=".24"/>
          ${showNaive ? `<polyline points="${naiveLine}" fill="none" stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="4,3"/>` : ""}
          <polyline points="${line}" fill="none" stroke="#ea580c" stroke-width="1.9"/>
          ${vi > 0 ? `<line x1="${X(vi)}" x2="${X(vi)}" y1="4" y2="${H - 20}" stroke="#14b8a6" stroke-dasharray="3"/><text x="${X(vi) + 4}" y="12">VIIRS S-NPP begins (2012)</text>` : ""}
          <text x="2" y="12">${fmt(mx)}</text>
          <text x="${p}" y="${H - 4}">${S[0].ym}</text>
          <text x="${W - 44}" y="${H - 4}">${S[S.length - 1].ym}</text>
        </svg>
        <div class="mut">Solid orange = harmonized VIIRS-equivalent series (shaded = 90% conformal band). Dashed grey = unharmonized raw sensor merge.</div>
      `;
