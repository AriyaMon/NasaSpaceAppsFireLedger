import numpy as np
import pandas as pd
from flask import Flask, jsonify, render_template, request, Response
import config as C
from pipeline.harmonize import counts_from_arrays, harmonize, annotate
from pipeline.firms_api import fetch_area_range
from pipeline import brief as B

app = Flask(__name__)
S = {}


def load():
    if not C.DETECTIONS.exists():
        raise SystemExit("No data found. Run: python -m pipeline.make_demo_data")
    df = pd.read_parquet(C.DETECTIONS).sort_values("date").reset_index(drop=True)
    S.update(
        df=df,
        lat=df.lat.to_numpy(),
        lon=df.lon.to_numpy(),
        sen=(df.sensor == "viirs").to_numpy(),
        mon=(df.date.dt.year * 12 + df.date.dt.month - 1).to_numpy().astype("int32"),
        demo=C.DEMO_FLAG.exists(),
    )
    S["m0"], S["m1"] = int(S["mon"].min()), int(S["mon"].max())
    S["global_model"] = harmonize(counts(None))[1]


def mask(b):
    return (
        (S["lat"] >= b["south"])
        & (S["lat"] <= b["north"])
        & (S["lon"] >= b["west"])
        & (S["lon"] <= b["east"])
    )


def counts(b):
    m = np.ones(len(S["lat"]), bool) if b is None else mask(b)
    return counts_from_arrays(S["mon"][m], S["sen"][m], S["m0"], S["m1"])


def parse_bbox():
    W = C.WORLD
    try:
        b = {k: float(request.args.get(k, W[k])) for k in ("west", "south", "east", "north")}
    except ValueError:
        return None
    b = dict(
        west=max(b["west"], W["west"]),
        east=min(b["east"], W["east"]),
        south=max(b["south"], W["south"]),
        north=min(b["north"], W["north"]),
    )
    return b if b["west"] < b["east"] and b["south"] < b["north"] else None


def js(v):
    return None if v is None or (isinstance(v, float) and v != v) else (float(v) if isinstance(v, (np.floating,)) else v)


def analysis(b):
    h, meta = harmonize(counts(b), fallback=S["global_model"])
    return annotate(h), meta


@app.get("/")
def index():
    return render_template("index.html")


@app.get("/api/health")
def health():
    return jsonify(ok=True, detections=len(S["df"]), demo=S["demo"], has_key=bool(C.MAP_KEY))


@app.get("/api/meta")
def meta():
    p = lambda o: pd.Period(year=o // 12, month=o % 12 + 1, freq="M").strftime("%Y-%m")
    return jsonify(
        world=C.WORLD,
        first=p(S["m0"]),
        last=p(S["m1"]),
        demo=S["demo"],
        unusual_pct=C.UNUSUAL_PCT,
    )


@app.post("/api/fetch_live")
def fetch_live():
    """Pull live NASA FIRMS MODIS + VIIRS detections for any global bounding box and date range."""
    body = request.get_json(silent=True) or {}
    try:
        b = {k: float(body[k]) for k in ("west", "south", "east", "north")}
    except (KeyError, ValueError, TypeError):
        return jsonify(error="Invalid bounding box coordinates"), 400

    start_date = body.get("start_date", "2023-05-01")
    end_date = body.get("end_date", "2023-09-30")

    try:
        new_df, stats = fetch_area_range(b, start_date, end_date, map_key=C.MAP_KEY)
    except Exception as e:
        return jsonify(error=str(e)), 502

    if not new_df.empty:
        # If switching from synthetic demo to real NASA data, replace synthetic table
        base_df = pd.DataFrame() if S["demo"] else S["df"]
        merged = pd.concat([base_df, new_df], ignore_index=True)
        merged = merged.drop_duplicates(subset=["date", "lat", "lon", "sensor"])
        merged["sensor"] = merged["sensor"].astype("category")
        C.PROC.mkdir(parents=True, exist_ok=True)
        merged.to_parquet(C.DETECTIONS)
        C.DEMO_FLAG.unlink(missing_ok=True)
        load()

    return jsonify(
        ok=True,
        fetched_rows=len(new_df),
        total_cached=len(S["df"]),
        demo=S["demo"],
        stats=stats,
    )


@app.get("/api/analyze")
def analyze():
    b = parse_bbox()
    if b is None:
        return jsonify(error="Invalid area of interest"), 400
    h, meta_ = analysis(b)
    st, en = request.args.get("start"), request.args.get("end")
    if st:
        h = h[h.index >= pd.Period(st, "M")]
    if en:
        h = h[h.index <= pd.Period(en, "M")]

    cols = [
        "year", "month", "value", "naive", "lo", "hi", "source",
        "modis", "viirs", "median", "ratio", "pct", "pct_lo", "pct_hi", "conf",
    ]
    series = [{"ym": str(i), **{c: js(r[c]) for c in cols}} for i, r in h.iterrows()]
    m = mask(b)

    return jsonify(
        aoi=b,
        unit="VIIRS-equivalent hotspots per month",
        series=series,
        metrics={k: js(v) for k, v in meta_.items()},
        n_detections=dict(modis=int((~S["sen"][m]).sum()), viirs=int(S["sen"][m].sum())),
        caveats=[
            "Hotspots are presence-only: cloud cover and thick smoke hide fires.",
            "Pre-2012 months are MODIS translated into VIIRS-equivalent units (dashed border).",
            "Before 2002-07 only Terra flew, so early MODIS intervals are widened 1.5x.",
            "Low-confidence pixels and non-vegetation thermal sources (flares, volcanoes) are filtered out.",
        ],
    )


@app.get("/api/hotspots.csv")
def hotspots_csv():
    b = parse_bbox()
    if b is None:
        return "Invalid area of interest", 400
    m = mask(b)
    df = S["df"][m]
    st, en = request.args.get("start"), request.args.get("end")
    if st:
        df = df[df.date >= pd.Period(st, "M").start_time]
    if en:
        df = df[df.date <= pd.Period(en, "M").end_time]
    df = df.head(C.MAX_CSV_ROWS)
    return Response(
        df.to_csv(index=False, date_format="%Y-%m-%d"),
        mimetype="text/csv",
        headers={"Content-Disposition": "attachment; filename=fireledger_hotspots.csv"},
    )


@app.get("/api/brief")
def brief():
    b = parse_bbox()
    if b is None:
        return jsonify(error="Invalid area of interest"), 400
    h, meta_ = analysis(b)
    ym = request.args.get("ym") or str(h.index[-1])
    try:
        row = h.loc[pd.Period(ym, "M")]
    except KeyError:
        return jsonify(error="Month not found"), 404
    if row["median"] != row["median"]:
        return jsonify(error="Not enough multi-year history in this box yet."), 422
    facts = B.build_facts(row, b, meta_)
    out = B.make_brief(facts, request.args.get("audience", "Responder"))
    return jsonify(facts=facts, **out)


load()

if __name__ == "__main__":
    app.run(debug=True, port=5000, use_reloader=False)
