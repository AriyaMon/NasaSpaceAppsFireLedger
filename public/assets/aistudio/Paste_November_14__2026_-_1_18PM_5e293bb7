"""Download FIRMS country archives and clean them. Run via: python -m pipeline.build"""
import numpy as np
import pandas as pd
import requests
import config as C


def archive_url(slug, year):
    return f"{C.BASE_URL}/{slug}/{year}/{slug}_{year}_{C.COUNTRY}.csv"


def download(slug, year):
    C.RAW.mkdir(parents=True, exist_ok=True)
    path = C.RAW / f"{slug}_{year}_{C.COUNTRY}.csv"
    if path.exists():
        return path
    r = requests.get(archive_url(slug, year), stream=True, timeout=300)
    if r.status_code == 404:
        print(f"  {slug} {year}: not published (404)")
        return None
    r.raise_for_status()
    tmp = path.with_suffix(".part")
    with open(tmp, "wb") as f:
        for chunk in r.iter_content(1 << 20):
            f.write(chunk)
    if "latitude" not in tmp.read_text(errors="ignore")[:400].lower():
        tmp.unlink()
        raise RuntimeError(f"{archive_url(slug, year)} did not return a hotspot CSV")
    tmp.rename(path)
    return path


def clean(path, sensor):
    """Return (clean detections, accounting dict). Every row dropped is counted."""
    df = pd.read_csv(path, low_memory=False)
    df.columns = [c.lower() for c in df.columns]
    acc = {"raw": len(df)}

    R = C.REGION
    df = df[df.latitude.between(R["south"], R["north"]) & df.longitude.between(R["west"], R["east"])]
    acc["in_region"] = len(df)

    # 0 = vegetation fire; drops volcano, flares, offshore
    if "type" in df:
        df = df[df["type"].fillna(0) == 0]
    acc["vegetation_type"] = len(df)

    conf = df["confidence"].astype(str).str.lower()
    keep = (
        pd.to_numeric(conf, errors="coerce") >= 30
        if sensor == "modis"
        else conf.isin(["n", "h", "nominal", "high"])
    )
    df = df[keep]
    acc["kept"] = len(df)

    out = pd.DataFrame({
        "date": pd.to_datetime(df["acq_date"]),
        "lat": df["latitude"].astype("float32"),
        "lon": df["longitude"].astype("float32"),
        "sensor": sensor,
        "frp": pd.to_numeric(df["frp"], errors="coerce").astype("float32") if "frp" in df else np.float32(np.nan),
        "daynight": df["daynight"] if "daynight" in df else None,
    })
    return out, acc
