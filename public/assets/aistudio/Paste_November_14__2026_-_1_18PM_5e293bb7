import numpy as np
import pandas as pd
import config as C

VIIRS_FROM = pd.Period(C.VIIRS_FULL_FROM, "M")
TWO_SAT_FROM = pd.Period(C.MODIS_TWO_SAT_FROM, "M")
ALPHA = 0.10

def counts_from_arrays(mon, is_viirs, m0, m1):
n = m1 - m0 + 1
mod = np.bincount(mon[~is_viirs] - m0, minlength=n)[:n]
vii = np.bincount(mon[is_viirs] - m0, minlength=n)[:n].astype(float)
idx = pd.period_range(pd.Period(year=m0 // 12, month=m0 % 12 + 1, freq="M"), periods=n, freq="M")
df = pd.DataFrame({"modis": mod.astype(float), "viirs": vii}, index=idx)
df.loc[df.index < VIIRS_FROM, "viirs"] = np.nan
return df

def _cq(res):
k = min(1.0, np.ceil((len(res) + 1) * (1 - ALPHA)) / len(res))
return float(np.quantile(res, k, method="higher"))

def _fit(x, y):
b, a = np.polyfit(x, y, 1)
return a, b

def fit_model(counts):
"""Fit log1p(VIIRS) ~ log1p(MODIS) on 2012+ overlap months using alternating-year CV."""
ov = counts.dropna(subset=["viirs"])
ov = ov[(ov.modis > 0) | (ov.viirs > 0)]
if len(ov) < 18 or ov.viirs.sum() < 25:
return None

x, y = np.log1p(ov.modis.values), np.log1p(ov.viirs.values)
even = ov.index.year % 2 == 0
folds, preds = [], np.full(len(ov), np.nan)

for tr, te in ((even, ~even), (~even, even)):
    if tr.sum() < 6 or te.sum() < 6:
        return None
    a, b = _fit(x[tr], y[tr])
    p = a + b * x[te]
    preds[te] = p
    folds.append(np.abs(y[te] - p))

q0, q1 = _cq(folds[0]), _cq(folds[1])
cover = (np.mean(folds[1] <= q0) + np.mean(folds[0] <= q1)) / 2

a, b = _fit(x, y)
obs, pr = np.expm1(y), np.expm1(preds)
ss_res, ss_tot = np.sum((y - preds) ** 2), np.sum((y - y.mean()) ** 2)

return dict(
    a=float(a),
    b=float(b),
    q=_cq(np.concatenate(folds)),
    n_overlap=int(len(ov)),
    mae=float(np.mean(np.abs(pr - obs))),
    bias_pct=float(100 * (pr.sum() - obs.sum()) / max(obs.sum(), 1)),
    r2_log=float(1 - ss_res / max(ss_tot, 1e-9)),
    coverage=float(cover),
    nominal=1 - ALPHA,
)
