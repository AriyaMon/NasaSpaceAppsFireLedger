        "lat_bin": np.floor(df26["lat"].to_numpy()).astype("int16"),
        "lon_bin": np.floor(df26["lon"].to_numpy()).astype("int16"),
        "modis": (df26["sensor"] == "modis").astype("int32"),
        "viirs": (df26["sensor"] == "viirs").astype("int32"),
    })
    grid_accum.append(g.groupby(["ym", "lat_bin", "lon_bin"], as_index=False).sum())
    print(f"  Added {len(df26):,} live 2026 global detections.")
    return len(df26)


# =============================================================================
# 5. CALIBRATE MODIS <-> VIIRS ACROSS SHARED TIMELINE & SAVE GRID SUMMARY
# =============================================================================
def build_harmonized_summary(grid_accum, total_rows):
    print("[4/5] Computing dual-satellite MODIS <-> VIIRS calibration...")
    grid = pd.concat(grid_accum, ignore_index=True).groupby(["ym", "lat_bin", "lon_bin"], as_index=False).sum()
    monthly = grid.groupby("ym", as_index=False)[["modis", "viirs"]].sum().sort_values("ym")

    x = np.log1p(monthly["modis"].to_numpy(dtype=float))
    y = np.log1p(monthly["viirs"].to_numpy(dtype=float))
    b, a = np.polyfit(x, y, 1)
    res = np.abs(y - (a + b * x))
    q90 = float(np.quantile(res, 0.90))

    grid["modis_viirs_eq"] = np.expm1(np.maximum(a + b * np.log1p(grid["modis"]), 0)).astype("float32")
    grid.to_parquet(MONTHLY_GRID_PARQUET, compression="zstd", index=False)

    meta = {
        "updated_utc": datetime.now(timezone.utc).isoformat(),
        "timeline_mode": "dual_satellite_both_online",
        "total_detections": int(total_rows),
        "first_ym": str(monthly["ym"].min()),
        "last_ym": str(monthly["ym"].max()),
        "global_calibration": {"a": float(a), "b": float(b), "q90": q90},
    }
    META_JSON.write_text(json.dumps(meta, indent=2), encoding="utf-8")
    print(f"  Dual-satellite calibration: log1p(VIIRS) = {a:.4f} + {b:.4f} * log1p(MODIS) (q90={q90:.4f})")
    return meta


# =============================================================================
# 6. INITIALIZE EMPTY GITHUB REPO (`main` BRANCH) & UPLOAD RELEASE ASSET
# =============================================================================
def push_to_github():
    print(f"[5/5] Pushing formatted dataset to GitHub ({GITHUB_REPO})...")
    repo_dir = WORK_DIR / "repo"
    if repo_dir.exists():
        subprocess.run(["rm", "-rf", str(repo_dir)], check=True)
    repo_dir.mkdir(parents=True, exist_ok=True)

    auth_url = f"https://x-access-token:{GITHUB_TOKEN}@github.com/{GITHUB_REPO}.git"

    # Initialize fresh local repo on 'main' so empty GitHub repos work cleanly
    subprocess.run(["git", "-C", str(repo_dir), "init", "-b", "main"], check=True)
    subprocess.run(["git", "-C", str(repo_dir), "config", "user.email", "kaggle-bot@fireledger.local"], check=True)
    subprocess.run(["git", "-C", str(repo_dir), "config", "user.name", "FireLedger Kaggle Builder"], check=True)
    subprocess.run(["git", "-C", str(repo_dir), "remote", "add", "origin", auth_url], check=True)

    # Pull existing main if non-empty, otherwise proceed as initial commit
    pull = subprocess.run(["git", "-C", str(repo_dir), "pull", "origin", "main"], capture_output=True)
    if pull.returncode != 0:
        print("  Empty repository detected — creating initial 'main' branch commit...")

    readme_path = repo_dir / "README.md"
    if not readme_path.exists():
        readme_path.write_text(
            "# NasaSpaceAppsFireLedger\n\n"
            "Harmonized Worldwide MODIS + VIIRS Active Fire Dataset (2012-03 – Present).\n"
            "Full `detections.parquet` is attached to the `data-latest` GitHub Release.\n",
            encoding="utf-8",
        )

    target_proc = repo_dir / "data" / "processed"
    target_proc.mkdir(parents=True, exist_ok=True)
    (target_proc / "harmonized_global_monthly.parquet").write_bytes(MONTHLY_GRID_PARQUET.read_bytes())
    (target_proc / "dataset_meta.json").write_bytes(META_JSON.read_bytes())

    subprocess.run(["git", "-C", str(repo_dir), "add", "-A"], check=True)
    subprocess.run(
        ["git", "-C", str(repo_dir), "commit", "-m", "Upload dual-satellite (2012-2026) MODIS+VIIRS summary"],
        check=False,
    )
    subprocess.run(["git", "-C", str(repo_dir), "push", "-u", "origin", "main"], check=True)

    # Create or update GitHub Release 'data-latest' for detections.parquet
    headers = {
        "Authorization": f"Bearer {GITHUB_TOKEN}",
        "Accept": "application/vnd.github+json",
    }
    rel_api = f"https://api.github.com/repos/{GITHUB_REPO}/releases"
    r = requests.get(f"{rel_api}/tags/data-latest", headers=headers, timeout=30)
    if r.status_code == 200:
        rel = r.json()
        for asset in rel.get("assets", []):
            if asset["name"] == "detections.parquet":
                requests.delete(f"{rel_api}/assets/{asset['id']}", headers=headers, timeout=30)
    else:
        r = requests.post(
            rel_api,
            headers=headers,
            json={
                "tag_name": "data-latest",
                "target_commitish": "main",
                "name": "Dual-Satellite NASA FIRMS Dataset (2012-Present)",
                "prerelease": False,
            },
            timeout=30,
        )
        r.raise_for_status()
        rel = r.json()

    upload_url = rel["upload_url"].split("{")[0] + "?name=detections.parquet"
    size_mb = DETECTIONS_PARQUET.stat().st_size / (1024 * 1024)
    print(f"  Uploading detections.parquet ({size_mb:.1f} MB) to GitHub Release 'data-latest'...")
    with open(DETECTIONS_PARQUET, "rb") as f:
        up = requests.post(
            upload_url,
            headers={**headers, "Content-Type": "application/octet-stream"},
            data=f,
            timeout=600,
        )
        up.raise_for_status()

    print("✓ Complete! AriyaMon/NasaSpaceAppsFireLedger and Release 'data-latest' are ready.")


