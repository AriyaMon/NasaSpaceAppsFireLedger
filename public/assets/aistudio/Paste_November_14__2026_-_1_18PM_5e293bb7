# 4. GAP-FILL 2026 LIVE DETECTIONS VIA NASA FIRMS AREA API
# =============================================================================
def fetch_2026_live_global(writer, grid_accum):
    today_str = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    print(f"[3/5] Fetching 2026 live global detections (2026-01-01 to {today_str})...")

    avail_url = f"{FIRMS_API_BASE}/data_availability/csv/{MAP_KEY}/ALL"
    avail_df = pd.read_csv(StringIO(requests.get(avail_url, timeout=30).text))
    avail = {r["data_id"]: (str(r["min_date"]), str(r["max_date"])) for _, r in avail_df.iterrows()}

    sources = {
        "modis": ["MODIS_SP", "MODIS_NRT"],
        "viirs": ["VIIRS_SNPP_SP", "VIIRS_SNPP_NRT", "VIIRS_NOAA20_SP", "VIIRS_NOAA20_NRT"],
    }
    s_dt = datetime.strptime("2026-01-01", "%Y-%m-%d").date()
    e_dt = datetime.strptime(today_str, "%Y-%m-%d").date()

    tasks = []
    for fam, srcs in sources.items():
        for src in srcs:
            if src not in avail:
                continue
            a_min = datetime.strptime(avail[src][0], "%Y-%m-%d").date()
            a_max = datetime.strptime(avail[src][1], "%Y-%m-%d").date()
            cur = max(s_dt, a_min)
            stop = min(e_dt, a_max)
            if src.endswith("_NRT") and src.replace("_NRT", "_SP") in avail:
                sp_max = datetime.strptime(avail[src.replace("_NRT", "_SP")][1], "%Y-%m-%d").date()
                cur = max(cur, sp_max + timedelta(days=1))
            while cur <= stop:
                days = min(5, (stop - cur).days + 1)
                tasks.append((fam, src, days, cur.strftime("%Y-%m-%d")))
                cur += timedelta(days=days)

    def _pull(fam, src, days, d_str):
        u = f"{FIRMS_API_BASE}/area/csv/{MAP_KEY}/{src}/-180,-90,180,90/{days}/{d_str}"
        try:
            r = requests.get(u, timeout=60)
            if r.status_code == 200 and "latitude" in r.text[:300].lower():
                return clean_firms_df(pd.read_csv(StringIO(r.text), low_memory=False), fam)
        except Exception:
            pass
        return pd.DataFrame()

    parts = []
    with ThreadPoolExecutor(max_workers=8) as pool:
        futs = [pool.submit(_pull, fam, src, days, d_str) for fam, src, days, d_str in tasks]
        for f in as_completed(futs):
            p = f.result()
            if not p.empty:
                parts.append(p)

    if not parts:
        return 0

    df26 = pd.concat(parts, ignore_index=True).drop_duplicates(subset=["date", "lat", "lon", "sensor"])
    writer.write_table(pa.Table.from_pandas(df26, schema=PARQUET_SCHEMA, preserve_index=False))

    g = pd.DataFrame({
        "ym": df26["date"].dt.to_period("M").astype(str),
        "lat_bin": np.floor(df26["lat"].to_numpy()).astype("int16"),
        "lon_bin": np.floor(df26["lon"].to_numpy()).astype("int16"),
        "modis": (df26["sensor"] == "modis").astype("int32"),
        "viirs": (df26["sensor"] == "viirs").astype("int32"),
    })
    grid_accum.append(g.groupby(["ym", "lat_bin", "lon_bin"], as_index=False).sum())
    print(f"  Added {len(df26):,} live 2026 global detections.")
    return len(df26)


