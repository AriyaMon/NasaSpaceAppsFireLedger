}

async function fetchLive() {
const btn = $("#fetchLive");
btn.disabled = true;
$("#status").textContent = "Querying NASA FIRMS API (MODIS + VIIRS)...";
try {
const res = await fetch("/api/fetch_live", {
method: "POST",
headers: { "Content-Type": "application/json" },
body: JSON.stringify({
west: $("#west").value,
south: $("#south").value,
east: $("#east").value,
north: $("#north").value,
start_date: $("#liveStart").value,
end_date: $("#liveEnd").value,
}),
});
const j = await res.json();
if (!res.ok) {
$("#status").textContent = "NASA API Error: " + (j.error || "Request failed");
return;
}
$("#demo").hidden = !j.demo;
$("#status").textContent = Pulled ${j.fetched_rows.toLocaleString()} live hotspots (${j.stats.api_calls} NASA API chunks).;
await run();
refreshGlobeCells();
} finally {
btn.disabled = false;
}
}

async function run() {
$("#status").textContent = "Harmonizing MODIS & VIIRS series…";
const r = await fetch("/api/analyze?" + q());
if (!r.ok) {
$("#status").textContent = "Invalid area of interest.";
return;
}
data = await r.json();
$("#csv").href = "/api/hotspots.csv?" + q();
$("#status").textContent = ${data.n_detections.modis.toLocaleString()} MODIS + ${data.n_detections.viirs.toLocaleString()} VIIRS detections in region.;
if (!sel || !data.series.find(s => s.ym === sel)) {
sel = data.series[data.series.length - 1].ym;
}
drawCal();
drawChart();
drawMetrics();
showSel();
}

function drawCal() {
const S = data.series;
const years = [...new Set(S.map(s => s.year))];
const by = Object.fromEntries(S.map(s => [s.ym, s]));
const mx = Math.log1p(Math.max(...S.map(s => s.value || 0), 1));
$("#lmax").textContent = fmt(Math.expm1(mx));
$("#lmin").textContent = "0";

let h = "" + MN.map(m => <th>${m}</th>).join("") + "";
for (const y of years) {
h += <tr><th>${y}</th>;
for (let m = 1; m <= 12; m++) {
const s = by[${y}-${String(m).padStart(2, "0")}];
if (!s || s.value == null) {
h += <td class="n"></td>;
continue;
}
const c = ramp(Math.log1p(s.value) / mx);
const flag = s.conf === "high" ? "▲" : "";
h += <td data-ym="${s.ym}" class="${s.source !== "viirs" ? "h" : ""} ${s.ym === sel ? "sel" : ""}" style="background:${c};color:${lum(c) > 140 ? "#000" : "#fff"}" title="${s.ym}: ${fmt(s.value)} (${fmt(s.lo)}–${fmt(s.hi)})">${flag}</td>;
}
h += "";
}
$("#cal").innerHTML = h + "";
document.querySelectorAll("#cal td[data-ym]").forEach(td => {
td.onclick = () => {
sel = td.dataset.ym;
drawCal();
showSel();
refreshGlobeCells();
};
});
}

function drawChart() {
const S = data.series.filter(s => s.value != null);
