async function fetchLive() {
  const btn = $("#fetchLive");
  btn.disabled = true;
  $("#status").textContent = "Querying NASA FIRMS API (MODIS + VIIRS)...";
  try {
    const res = await fetch("/api/fetch_live", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        west: $("#west").value,
        south: $("#south").value,
        east: $("#east").value,
        north: $("#north").value,
        start_date: $("#liveStart").value,
        end_date: $("#liveEnd").value,
      }),
    });
    const j = await res.json();
    if (!res.ok) {
      $("#status").textContent = "NASA API Error: " + (j.error || "Request failed");
      return;
    }
    $("#demo").hidden = !j.demo;
    $("#status").textContent = `Fetched ${j.fetched_rows.toLocaleString()} live hotspots (${j.stats.api_calls} API chunks). Re-analyzing...`;
    await run();
  } finally {
    btn.disabled = false;
  }
}

async function run() {
  $("#status").textContent = "Analyzing harmonized series…";
  const r = await fetch("/api/analyze?" + q());
  if (!r.ok) {
    $("#status").textContent = "Invalid area of interest.";
    return;
  }
  data = await r.json();
  $("#csv").href = "/api/hotspots.csv?" + q();
  $("#status").textContent = `${data.n_detections.modis.toLocaleString()} MODIS + ${data.n_detections.viirs.toLocaleString()} VIIRS detections in region.`;
  if (!sel || !data.series.find(s => s.ym === sel)) {
    sel = data.series[data.series.length - 1].ym;
  }
  drawCal();
  drawChart();
  drawMetrics();
  showSel();
}

function drawCal() {
  const S = data.series;
  const years = [...new Set(S.map(s => s.year))];
  const by = Object.fromEntries(S.map(s => [s.ym, s]));
  const mx = Math.log1p(Math.max(...S.map(s => s.value || 0), 1));
  $("#lmax").textContent = fmt(Math.expm1(mx));
  $("#lmin").textContent = "0";

  let h = "<table><tr><th></th>" + MN.map(m => `<th>${m}</th>`).join("") + "</tr>";
  for (const y of years) {
    h += `<tr><th>${y}</th>`;
    for (let m = 1; m <= 12; m++) {
      const s = by[`${y}-${String(m).padStart(2, "0")}`];
      if (!s || s.value == null) {
        h += `<td class="n"></td>`;
        continue;
      }
      const c = ramp(Math.log1p(s.value) / mx);
      const flag = s.conf === "high" ? "▲" : "";
      h += `<td data-ym="${s.ym}" class="${s.source !== "viirs" ? "h" : ""} ${s.ym === sel ? "sel" : ""}" style="background:${c};color:${lum(c) > 140 ? "#000" : "#fff"}" title="${s.ym}: ${fmt(s.value)} (${fmt(s.lo)}–${fmt(s.hi)})">${flag}</td>`;
    }
    h += "</tr>";
  }
  $("#cal").innerHTML = h + "</table>";
  document.querySelectorAll("#cal td[data-ym]").forEach(td => {
    td.onclick = () => {
      sel = td.dataset.ym;
      drawCal();
      showSel();
    };
  });
}

function drawChart() {
  const S = data.series.filter(s => s.value != null);
  if (S.length < 2) return;
  const W = 680, H = 185, p = 32;
  const showNaive = $("#showNaive").checked;
  const mx = Math.max(...S.map(s => Math.max(s.hi || 0, showNaive ? (s.naive || 0) : 0)), 1);
  const X = i => p + (i / (S.length - 1)) * (W - p - 8);
  const Y = v => H - 20 - (v / mx) * (H - 34);

  const band = S.map((s, i) => `${X(i)},${Y(s.hi)}`).join(" ") + " " +
    S.map((s, i) => `${X(S.length - 1 - i)},${Y(S[S.length - 1 - i].lo)}`).join(" ");
  const line = S.map((s, i) => `${X(i)},${Y(s.value)}`).join(" ");
  const naiveLine = S.map((s, i) => `${X(i)},${Y(s.naive || 0)}`).join(" ");
  const vi = S.findIndex(s => s.source === "viirs");

  $("#chart").innerHTML = `
    <svg viewBox="0 0 ${W} ${H}" width="100%">
      <polygon points="${band}" fill="#c2410c" opacity=".22"/>
      ${showNaive ? `<polyline points="${naiveLine}" fill="none" stroke="#64748b" stroke-width="1.2" stroke-dasharray="4,3"/>` : ""}
      <polyline points="${line}" fill="none" stroke="#c2410c" stroke-width="1.8"/>
      ${vi > 0 ? `<line x1="${X(vi)}" x2="${X(vi)}" y1="4" y2="${H - 20}" stroke="#0f766e" stroke-dasharray="3"/><text x="${X(vi) + 4}" y="12">VIIRS S-NPP begins (2012)</text>` : ""}
      <text x="2" y="12">${fmt(mx)}</text>
      <text x="${p}" y="${H - 4}">${S[0].ym}</text>
      <text x="${W - 44}" y="${H - 4}">${S[S.length - 1].ym}</text>
    </svg>
    <div class="mut">Solid orange = harmonized VIIRS-equivalent series (shaded = 90% conformal band). Dashed grey = unharmonized raw sensor merge.</div>
  `;
}

function drawMetrics() {
  const m = data.metrics;
  const c = (b, l) => `<div class="card"><b>${b}</b><div class="mut">${l}</div></div>`;
  $("#metrics").innerHTML = m.n_overlap
    ? c(fmt(m.mae), "MAE (hotspots/mo, held-out)") +
      c((m.bias_pct >= 0 ? "+" : "") + fmt(m.bias_pct) + "%", "Out-of-fold bias") +
      c(Math.round(m.coverage * 100) + "%", `90% band coverage`) +
      c(m.n_overlap, `Overlap months (${m.model_source})`)
    : c("n/a", "Not enough historical overlap in this box.");
  $("#cav").innerHTML = data.caveats.map(x => `<li>${x}</li>`).join("");
}

function showSel() {
  const s = data.series.find(x => x.ym === sel);
  if (!s) return;
  const med = s.median == null ? "insufficient history" : `${fmt(s.median)} (${Math.round(100 * s.ratio)}% of median)`;
  $("#sel").innerHTML = `
    <div class="card">
      <b>${MN[s.month - 1]} ${s.year}</b> · ${fmt(s.value)} hotspots<br>
      <span class="mut">
        90% range: ${fmt(s.lo)}–${fmt(s.hi)} · ${s.source === "viirs" ? "observed (VIIRS)" : "harmonized from MODIS"}<br>
        Same-month median: ${med}<br>
        Percentile: ${s.pct == null ? "–" : Math.round(s.pct)} · Anomaly confidence: <b style="font-size:inherit">${s.conf}</b>
      </span>
    </div>
  `;
  brief();
}

async function brief() {
  if (!sel) return;
  const p = q();
  p.set("ym", sel);
  p.set("audience", audience);
  const r = await fetch("/api/brief?" + p);
  const j = await r.json();
  $("#brief").textContent = r.ok ? j.text : (j.error || "No briefing available.");
  if (r.ok) {
    const t = document.createElement("div");
    t.className = "mut";
    t.style.marginTop = "6px";
    t.textContent = `✓ ${j.figures} numbers verified against data · source: ${j.source}`;
    $("#brief").appendChild(t);
  }
}

