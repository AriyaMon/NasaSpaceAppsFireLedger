model, used = fit_model(counts), "aoi"
if model is None and fallback is not None and fallback.get("n_overlap"):
model, used = dict(fallback, q=fallback["q"] * 2.0), "global_fallback"

out = counts.copy()
out["value"] = out["viirs"]
out["modis_eq"] = np.nan
out["lo"] = out["viirs"]
out["hi"] = out["viirs"]
out["source"] = "dual_sensor"
out["naive"] = out["modis"]

if model is not None:
    p = model["a"] + model["b"] * np.log1p(out["modis"].values)
    q = model["q"]
    out["modis_eq"] = np.expm1(np.maximum(p, 0))
    out["lo"] = np.expm1(np.maximum(p - q, 0))
    out["hi"] = np.expm1(p + q)

meta = dict(model) if model else {}
meta["model_source"] = used if model else "none"
return out, meta
