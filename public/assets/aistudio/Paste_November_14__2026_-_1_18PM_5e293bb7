# 2. DISCOVER ALL COUNTRIES WORLDWIDE ON NASA FIRMS
# =============================================================================
def discover_all_countries():
    discovered = set()
    for slug in ("modis", "viirs-snpp"):
        url = f"{FIRMS_COUNTRY_BASE}/{slug}/2023/"
        r = requests.get(url, timeout=30)
        if r.status_code == 200:
            matches = re.findall(rf"{slug}_2023_([A-Za-z0-9_\-\.]+)\.csv", r.text)
            for m in matches:
                if m.lower() != "world":
                    discovered.add(m)
    countries = sorted(discovered)
    if len(countries) < 100:
        raise RuntimeError(f"Expected ~240 countries from NASA FIRMS, only found {len(countries)}.")
    print(f"[1/5] Discovered {len(countries)} countries/territories worldwide.")
    return countries


# =============================================================================
# 3. CLEAN & STREAM COUNTRY-BY-COUNTRY TO PARQUET (LOW RAM, ZERO OOM)
# =============================================================================
def clean_firms_df(df, sensor_family):
    if df is None or df.empty:
        return pd.DataFrame()
    df.columns = [c.lower().strip() for c in df.columns]

    # Filter out static industrial heat / gas flares / volcanoes (type == 0)
    if "type" in df.columns:
        df = df[pd.to_numeric(df["type"], errors="coerce").fillna(0) == 0]

    # Confidence filtering
    if "confidence" in df.columns:
        conf = df["confidence"].astype(str).str.lower().str.strip()
        if sensor_family == "modis":
            df = df[pd.to_numeric(conf, errors="coerce") >= 30]
        else:
            df = df[conf.isin(["n", "h", "nominal", "high"])]

    if df.empty:
        return pd.DataFrame()

    inst = df["instrument"].astype(str) if "instrument" in df.columns else sensor_family.upper()
    out = pd.DataFrame({
        "date": pd.to_datetime(df["acq_date"], errors="coerce"),
        "lat": pd.to_numeric(df["latitude"], errors="coerce").astype("float32"),
        "lon": pd.to_numeric(df["longitude"], errors="coerce").astype("float32"),
        "sensor": sensor_family,
        "instrument": inst,
        "frp": pd.to_numeric(df["frp"], errors="coerce").fillna(0.0).astype("float32")
        if "frp" in df.columns else np.float32(0.0),
        "daynight": df["daynight"].astype(str) if "daynight" in df.columns else "D",
    }).dropna(subset=["date", "lat", "lon"])

    return out.drop_duplicates(subset=["date", "lat", "lon", "sensor"])


def fetch_country_year(slug, year, country):
    url = f"{FIRMS_COUNTRY_BASE}/{slug}/{year}/{slug}_{year}_{country}.csv"
    sensor_family = "modis" if slug == "modis" else "viirs"
    for attempt in range(3):
        try:
            r = requests.get(url, timeout=90)
            if r.status_code == 404:
                return pd.DataFrame()
            r.raise_for_status()
            txt = r.text
            if "latitude" not in txt[:300].lower():
                return pd.DataFrame()
            raw = pd.read_csv(StringIO(txt), low_memory=False)
            return clean_firms_df(raw, sensor_family)
        except Exception:
            time.sleep(1.5 * (attempt + 1))
    return pd.DataFrame()


def stream_worldwide_archives(countries, writer):
    print("[2/5] Downloading & streaming all country archives (2000–2025) to Parquet...")
    total_rows = 0
    grid_accum = []

    for idx, country in enumerate(countries, 1):
        tasks = [
            (slug, y, country)
            for _, (slug, years) in PRODUCTS.items()
            for y in years
        ]
        country_parts = []
        with ThreadPoolExecutor(max_workers=12) as pool:
            futs = [pool.submit(fetch_country_year, s, y, c) for s, y, c in tasks]
            for f in as_completed(futs):
                part = f.result()
                if not part.empty:
                    country_parts.append(part)

        if country_parts:
            cdf = pd.concat(country_parts, ignore_index=True)
            cdf = cdf.drop_duplicates(subset=["date", "lat", "lon", "sensor"])
            table = pa.Table.from_pandas(cdf, schema=PARQUET_SCHEMA, preserve_index=False)
            writer.write_table(table)
            total_rows += len(cdf)

            # Accumulate compact 1-degree monthly grid counts in memory
            g = pd.DataFrame({
                "ym": cdf["date"].dt.to_period("M").astype(str),
                "lat_bin": np.floor(cdf["lat"].to_numpy()).astype("int16"),
                "lon_bin": np.floor(cdf["lon"].to_numpy()).astype("int16"),
                "modis": (cdf["sensor"] == "modis").astype("int32"),
                "viirs": (cdf["sensor"] == "viirs").astype("int32"),
            })
            grid_accum.append(g.groupby(["ym", "lat_bin", "lon_bin"], as_index=False).sum())

        if idx % 20 == 0 or idx == len(countries):
            print(f"  [{idx}/{len(countries)}] {country} done | Cumulative rows: {total_rows:,}")

    return total_rows, grid_accum


