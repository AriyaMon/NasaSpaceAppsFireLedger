.filterBounds(aoi)
.filterDate('{pre_start}', '{pre_end}')
.filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30))
.map(maskS2clouds)
.map(addNBR)
.median();

var postFire = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
.filterBounds(aoi)
.filterDate('{fire_start}', '{post_end}')
.filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30))
.map(maskS2clouds)
.map(addNBR)
