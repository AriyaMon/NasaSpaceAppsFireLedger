function maskS2clouds(img) {{
var scl = img.select('SCL');
var mask = scl.neq(3).and(scl.neq(8)).and(scl.neq(9)).and(scl.neq(10));
return img.updateMask(mask).divide(10000);
}}

function addNBR(img) {{
// Sentinel-2 NIR (B8) and SWIR2 (B12)
