rng = np.random.default_rng(42)

Representative global fire regimes: (lat, lon, peak_month, spread_months, base_rate, spike_year)
REGIMES = [
(51.5, -72.0, 6.5, 1.5, 55, 2023),   # Boreal Canada (Quebec)
(38.5, -121.0, 8.0, 1.8, 50, 2020),  # Western US / California
(-10.5, -55.0, 8.5, 1.6, 95, 2024),  # Amazon / Mato Grosso
(-12.0, 24.0, 7.5, 2.0, 110, 2022),  # Sub-Saharan Savanna
(39.5, 22.0, 7.5, 1.4, 35, 2021),    # Mediterranean Europe
(-2.0, 113.0, 9.0, 1.5, 65, 2019),   # Borneo / Indonesia
(-33.5, 149.5, 12.0, 1.8, 60, 2019), # Eastern Australia
(62.0, 129.0, 7.0, 1.5, 45, 2021),   # Siberian Taiga
]

rows = []
for y in range(2000, 2027):
max_m = 11 if y == 2026 else 12
for m in range(1, max_m + 1):
for lat0, lon0, pk, spr, base, spike_y in REGIMES:
dist = min(abs(m - pk), 12 - abs(m - pk))
season = np.exp(-((dist / spr)  2)) + 0.04
lam = base * season * (0.6 + rng.random() * 0.9) * (4.5 if y == spike_y else 1.0)
for sensor, mult, start in (("modis", 1.0, (2000, 11)), ("viirs", 2.35, (2012, 3))):
if (y, m) < start:
continue
n = rng.poisson(lam * mult * (0.85 + 0.3 * rng.random()))
if n == 0:
continue
lat = np.clip(lat0 + rng.normal(0, 2.2, n), -89.9, 89.9)
lon = np.clip(lon0 + rng.normal(0, 3.0, n), -179.9, 179.9)
